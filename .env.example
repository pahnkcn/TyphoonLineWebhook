# ใจดี Chatbot - Configuration Template
# Copy this file to .env and fill in your actual values

# ====================
# LINE API Credentials
# ====================
# Get these from LINE Developer Console: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# =======================
# Redis Configuration
# =======================
# For local development, use localhost
# For Docker, use 'redis' (service name in docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =======================
# MySQL Configuration
# =======================
# For local development, use localhost
# For Docker, use 'db' (service name in docker-compose)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=change_this_password
MYSQL_PASSWORD=change_this_password
MYSQL_DB=chatbot

# =======================
# Docker Compose Settings
# =======================
MYSQL_ROOT_PASSWORD=change_this_password

# =======================
# Application Settings
# =======================
# Set to production when deploying
ENVIRONMENT=development
# Log level options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
DASHBOARD_API_KEY=your_dashboard_api_key_here
# Webhook security key for form submissions
FORM_WEBHOOK_KEY=your_webhook_key_here

# =======================
# Admin Alerting (LINE Notify)
# =======================
# Get token from: https://notify-bot.line.me/
# Set ADMIN_ALERT_ENABLED=true to activate
LINE_NOTIFY_TOKEN=your_line_notify_token_here
ADMIN_ALERT_ENABLED=false
ADMIN_ALERT_COOLDOWN=300

# =======================
# Multi-AI Consensus
# =======================
# Enable multi-AI mode: sends messages to multiple AI providers,
# cross-evaluates responses, and returns the best one.
# Only providers with valid API keys will be used.
MULTI_AI_ENABLED=false
MULTI_AI_TIMEOUT=45

# RAG (Retrieval-Augmented Generation)
# If true, AI will retrieve context from files in /knowledge_docs
RAG_ENABLED=true
RAG_MIN_SCORE=0.42
RAG_CHUNK_SIZE=1100
RAG_CHUNK_OVERLAP=120
RAG_EMBEDDING_DIM=1536
RAG_TOP_K=4
RAG_FETCH_K=36
RAG_MAX_CONTEXT_CHARS=5200

# ChatGPT (OpenAI) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini (Google) — https://aistudio.google.com/apikey
# Used by multi-AI (chat) and as RAG embedding fallback (priority #2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional RAG embedding model override (default: gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Grok (xAI) — https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-reasoning

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Kimi / Moonshot — https://platform.moonshot.ai/
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k

# OpenRouter (1 key = multiple models) — https://openrouter.ai/settings/keys
# Used by multi-AI consensus and as primary RAG embedding provider (priority #1).
# Optional RAG embedding model override (default: openai/text-embedding-3-small)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Each model below becomes a separate provider in the consensus system.
# Model format: provider/model-name (see https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-4o,anthropic/claude-sonnet-4-5,google/gemini-2.5-flash

# =======================
# Testing / Debug
# =======================
# Enable /skipverify command (for testing only, do NOT enable in production)
ENABLE_SKIP_VERIFY=false
